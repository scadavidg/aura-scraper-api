GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_studio_api_key_here
OPEN_ROUTER_API_KEY=your_openrouter_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
S3_REGION=us-east-2
S3_ENDPOINT=your_s3_endpoint
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_API_KEY=your_publishable_key
PRICE_MANAGER_API_KEY=your_price_manager_key
SCRAPER_API_TOKEN=scraper_default_token_for_local_dev
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
PORT=3000

# ── Sync ligero de precios (/sync-prices, /search-urls) ──
# Hosts permitidos para fetch directo al JSON de Shopify del proveedor
SYNC_ALLOWED_HOSTS=disfragancias.com,www.disfragancias.com
# Host para búsqueda semántica de URLs de producto (Tavily site:)
SYNC_SEARCH_HOST=disfragancias.com
# Delay aleatorio entre fetches al proveedor (anti-ban)
SYNC_DELAY_MIN_MS=500
SYNC_DELAY_MAX_MS=1500
# Concurrencia global hacia el proveedor (mantener en 1)
MAX_CONCURRENT_SYNC=1